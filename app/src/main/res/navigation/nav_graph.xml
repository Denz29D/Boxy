<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@+id/nav_home">

    <!-- Main (Bottom Navigation) Fragments -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.boxy.HomeFragment"
        android:label="Home"
        tools:layout="@layout/activity_home_acivity">
        <!-- Action to navigate to push-up counter -->
        <action
            android:id="@+id/action_nav_home_to_pushUpCounterFragment"
            app:destination="@id/pushUpCounterFragment" />
        <!-- NEW: Action to navigate to Gym Locator -->
        <action
            android:id="@+id/action_nav_home_to_gymLocatorFragment"
            app:destination="@id/gymLocatorFragment" />
    </fragment>

    <fragment
        android:id="@+id/workoutsFragment"
        android:name="com.example.boxy.WorkoutsFragment"
        android:label="Workouts"
        tools:layout="@layout/fragment_workouts">
        <action
            android:id="@+id/action_workoutsFragment_to_workoutDetailsFragment"
            app:destination="@id/workoutDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_discover"
        android:name="com.example.boxy.Discover"
        android:label="Discover"
        tools:layout="@layout/fragment_discover" />

    <fragment
        android:id="@+id/nav_stats"
        android:name="com.example.boxy.Stats"
        android:label="Stats"
        tools:layout="@layout/fragment_stats" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.boxy.Profile"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Detail Fragments (Not part of bottom nav) -->
    <fragment
        android:id="@+id/workoutDetailsFragment"
        android:name="com.example.boxy.WorkoutDetails"
        android:label="Workout Details"
        tools:layout="@layout/fragment_workout_details">
        <argument
            android:name="workoutId"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <!-- Push-Up Counter Fragment -->
    <fragment
        android:id="@+id/pushUpCounterFragment"
        android:name="com.example.boxy.PushUpCounterFragment"
        android:label="Push-Up Counter"
        tools:layout="@layout/fragment_pushup_counter" />

    <!-- NEW: Gym Locator Fragment -->
    <fragment
        android:id="@+id/gymLocatorFragment"
        android:name="com.example.boxy.GymLocatorFragment"
        android:label="Gym Locator"
        tools:layout="@layout/activity_maps" />

</navigation>
