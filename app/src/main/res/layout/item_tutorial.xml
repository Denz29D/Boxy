<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/CardView.App"
    android:layout_width="280dp"
    android:layout_height="180dp"
    android:layout_marginEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_tutorial"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:contentDescription="Tutorial Video"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_video"
            android:background="@color/gray_light"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tv_tutorial_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Basic Boxing Stance"
            android:textAppearance="@style/TextAppearance.App.Subtitle1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tutorial_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Learn the proper boxing stance"
            android:textAppearance="@style/TextAppearance.App.Body1" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
